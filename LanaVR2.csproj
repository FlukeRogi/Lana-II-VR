<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LanaVR2</AssemblyName>
    <RootNamespace>LanaVR2</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Planet of Lana 2</GameDir>
    <OutputPath>build\</OutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <SkyboxImage Include="skybox\*.lvsky;skybox\*.png;skybox\skyboxes.txt" />
  </ItemGroup>
  <Target Name="Deploy" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx') And '$(NoDeploy)' != 'true'">
    <Copy SourceFiles="@(SkyboxImage)" DestinationFolder="$(GameDir)\BepInEx\plugins\LanaVR2\skybox" />
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\LanaVR2" />
    <Copy SourceFiles="$(OutputPath)LanaVR2.dll" DestinationFolder="$(GameDir)\BepInEx\plugins\LanaVR2" />
    <Copy SourceFiles="native\build\Release\LanaVR2Native.dll;tools\openxr\native\x64\release\bin\openxr_loader.dll" DestinationFolder="$(GameDir)\BepInEx\plugins\LanaVR2" Condition="Exists('native\build\Release\LanaVR2Native.dll')" />
  </Target>
</Project>

